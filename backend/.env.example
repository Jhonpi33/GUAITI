# Copia este archivo como .env y completa los valores
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/guaiti?retryWrites=true&w=majority
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
PORT=4100

# Semilla del primer administrador (solo la usa `npm run seed:admin`)
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@guaiti.com
ADMIN_PASSWORD=Cambia1234*

# Fotos de daños y gastos (Cloudinary). Si están vacías, las fotos se guardan
# en backend/uploads/ y el sistema sigue funcionando.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
